{
  "name": "codex-sessions-viewer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env CODEX_VIEWER_MODE=live nuxt build",
    "coverage": "vitest run --coverage --testTimeout=15000 --maxWorkers=1 --no-file-parallelism",
    "dev": "jiti scripts/live.ts --dev",
    "doctor": "jiti scripts/doctor.ts",
    "export": "jiti scripts/export.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "live": "jiti scripts/live.ts",
    "offline": "jiti scripts/offline.ts",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --project node tests/integration --passWithNoTests",
    "test:performance": "vitest run --project performance",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.custom.json",
    "verify:output": "jiti scripts/verify-output.ts",
    "verify:release": "pnpm verify:source && pnpm build && pnpm test:e2e",
    "verify:source": "pnpm exec nuxt prepare && pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm test:performance && pnpm coverage"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "~5.3.0",
    "@fontsource-variable/geist": "~5.3.0",
    "@fontsource-variable/newsreader": "~5.3.0",
    "@phosphor-icons/vue": "~2.2.1",
    "@pierre/diffs": "~1.4.2",
    "@tanstack/vue-virtual": "~3.13.39",
    "@vueuse/core": "~14.4.0",
    "chokidar": "~5.0.0",
    "env-paths": "~4.0.0",
    "file-type": "~22.1.0",
    "gray-matter": "~4.0.3",
    "h3": "~1.15.11",
    "mermaid": "~12.0.0",
    "nuxt": "~4.5.2",
    "pagefind": "~1.5.2",
    "rehype-raw": "~7.0.0",
    "rehype-sanitize": "~6.0.0",
    "rehype-stringify": "~10.0.1",
    "remark-gfm": "~4.0.1",
    "remark-parse": "~11.0.0",
    "remark-rehype": "~11.1.2",
    "shiki": "~4.4.3",
    "unified": "~11.0.5",
    "vue": "~3.5.42",
    "yaml": "~2.9.1",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.13.0",
    "@nuxt/test-utils": "~4.3.2",
    "@playwright/test": "~1.63.0",
    "@testing-library/vue": "~8.1.0",
    "@types/hast": "~3.0.5",
    "@types/mdast": "~4.0.4",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "~6.0.9",
    "@vitest/coverage-v8": "~5.0.0",
    "@vue/test-utils": "~2.5.0",
    "cross-env": "~10.1.0",
    "happy-dom": "~20.14.5",
    "jiti": "~2.7.0",
    "node": "~26.8.2",
    "oxfmt": "~0.67.0",
    "oxlint": "~1.82.0",
    "oxlint-tsgolint": "~7.0.2001",
    "typescript": "~6.0.3",
    "vitest": "~5.0.0",
    "vue-tsc": "~3.3.11"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@11.26.0"
}
