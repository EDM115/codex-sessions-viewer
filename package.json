{
  "name": "codex-sessions-viewer",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*",
    "#server/*": "./server/*"
  },
  "scripts": {
    "build": "cross-env CODEX_VIEWER_MODE=live nuxt build",
    "coverage": "vitest run --coverage --testTimeout=15000 --maxWorkers=1 --no-file-parallelism",
    "dev": "jiti scripts/live.ts --dev",
    "doctor": "jiti scripts/doctor.ts",
    "export": "jiti scripts/export.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "live": "jiti scripts/live.ts",
    "offline": "jiti scripts/offline.ts",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --project node --project http tests/integration tests/http --passWithNoTests",
    "test:performance": "vitest run --project performance",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.custom.json",
    "verify:output": "jiti scripts/verify-output.ts",
    "verify:release": "pnpm verify:source && pnpm build && pnpm test:e2e",
    "verify:source": "pnpm exec nuxt prepare && pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm test:performance && pnpm coverage"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "~5.3.0",
    "@fontsource-variable/geist": "~5.3.0",
    "@fontsource-variable/newsreader": "~5.3.0",
    "@phosphor-icons/vue": "~2.2.1",
    "@pierre/diffs": "~1.6.2",
    "@tanstack/vue-virtual": "~3.13.49",
    "@vueuse/core": "~15.0.0",
    "chokidar": "~6.0.0",
    "env-paths": "~4.0.0",
    "file-type": "~22.2.0",
    "gray-matter": "~4.0.3",
    "mermaid": "~12.2.0",
    "nuxt": "~4.6.3",
    "pagefind": "~1.5.2",
    "rehype-raw": "~7.0.0",
    "rehype-sanitize": "~6.0.0",
    "rehype-stringify": "~10.0.1",
    "remark-gfm": "~4.0.1",
    "remark-parse": "~11.0.0",
    "remark-rehype": "~11.1.2",
    "shiki": "~4.5.0",
    "unified": "~11.0.5",
    "vue": "~3.5.44",
    "yaml": "~2.9.1",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@nuxt/test-utils": "~4.3.4",
    "@playwright/test": "~1.64.1",
    "@testing-library/vue": "~8.1.0",
    "@types/hast": "~3.0.5",
    "@types/mdast": "~4.0.4",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "~6.0.10",
    "@vitest/coverage-v8": "~5.0.5",
    "@vue/test-utils": "~2.5.1",
    "cross-env": "~10.1.0",
    "happy-dom": "~21.0.4",
    "jiti": "~2.7.0",
    "node": "~26.12.1",
    "oxfmt": "~0.75.0",
    "oxlint": "~1.90.0",
    "oxlint-tsgolint": "~7.0.2005",
    "typescript": "~6.0.3",
    "vitest": "~5.0.5",
    "vue-tsc": "~3.3.13"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@11.28.9"
}
